{
  "$schema": "https://forge.ui8.ai/schemas/stories.v3.json",
  "name": "Switch",
  "component": "./Switch.tsx#Switch",
  "canvas": {
    "layout": "centered"
  },
  "sections": [
    {
      "title": null,
      "controls": [
        {
          "prop": "theme",
          "control": "segmented",
          "label": "Theme",
          "options": [
            "light",
            "dark"
          ],
          "default": "light"
        },
        {
          "prop": "checked",
          "control": "switch",
          "label": "On",
          "default": false
        },
        {
          "prop": "size",
          "control": "segmented",
          "label": "Size",
          "options": [
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        },
        {
          "prop": "labelSide",
          "control": "segmented",
          "label": "Label side",
          "options": [
            "left",
            "right"
          ],
          "default": "right"
        }
      ]
    },
    {
      "title": "Lens",
      "collapsible": true,
      "controls": [
        {
          "prop": "lensScale",
          "control": "slider",
          "label": "Lens swell",
          "min": 1,
          "max": 2.2,
          "step": 0.01,
          "default": 1.55
        },
        {
          "prop": "refraction",
          "control": "slider",
          "label": "Refraction",
          "min": 0,
          "max": 60,
          "step": 1,
          "default": 26
        },
        {
          "prop": "knobBounce",
          "control": "slider",
          "label": "Knob bounce",
          "min": 0,
          "max": 0.9,
          "step": 0.01,
          "default": 0.3
        }
      ]
    },
    {
      "title": "State",
      "collapsible": true,
      "controls": [
        {
          "prop": "disabled",
          "control": "switch",
          "label": "Disabled",
          "default": false
        }
      ]
    }
  ],
  "values": {
    "label": "Notifications",
    "description": "Banners and sounds"
  }
}
