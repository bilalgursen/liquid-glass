{
  "$schema": "https://forge.ui8.ai/schemas/stories.v3.json",
  "name": "Checkbox",
  "component": "./Checkbox.tsx#Checkbox",
  "canvas": {
    "layout": "centered"
  },
  "sections": [
    {
      "title": null,
      "controls": [
        {
          "prop": "theme",
          "control": "segmented",
          "label": "Theme",
          "options": [
            "light",
            "dark"
          ],
          "default": "light"
        },
        {
          "prop": "checked",
          "control": "switch",
          "label": "Checked",
          "default": true
        },
        {
          "prop": "shape",
          "control": "segmented",
          "label": "Shape",
          "options": [
            "rounded",
            "circle"
          ],
          "default": "rounded"
        },
        {
          "prop": "size",
          "control": "segmented",
          "label": "Size",
          "options": [
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        }
      ]
    },
    {
      "title": "Glass",
      "collapsible": true,
      "controls": [
        {
          "prop": "swell",
          "control": "slider",
          "label": "Press swell",
          "min": 1,
          "max": 1.6,
          "step": 0.01,
          "default": 1.18
        },
        {
          "prop": "disabled",
          "control": "switch",
          "label": "Disabled",
          "default": false
        }
      ]
    }
  ],
  "values": {
    "label": "Remember this device",
    "description": "Skip sign-in for 30 days"
  }
}
