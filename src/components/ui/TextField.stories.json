{
  "$schema": "https://forge.ui8.ai/schemas/stories.v3.json",
  "name": "Text Field",
  "component": "./TextField.tsx#TextField",
  "canvas": {
    "layout": "centered"
  },
  "sections": [
    {
      "title": null,
      "controls": [
        {
          "prop": "theme",
          "control": "segmented",
          "label": "Theme",
          "options": [
            "light",
            "dark"
          ],
          "default": "light"
        },
        {
          "prop": "size",
          "control": "segmented",
          "label": "Size",
          "options": [
            "md",
            "lg"
          ],
          "default": "md"
        },
        {
          "prop": "shape",
          "control": "segmented",
          "label": "Shape",
          "options": [
            "pill",
            "rounded"
          ],
          "default": "pill"
        },
        {
          "prop": "frost",
          "control": "slider",
          "label": "Frost",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.6
        }
      ]
    },
    {
      "title": "Behavior",
      "collapsible": true,
      "controls": [
        {
          "prop": "icon",
          "control": "select",
          "label": "Icon",
          "options": [
            "none",
            "sun",
            "moon",
            "plus",
            "minus",
            "check",
            "close",
            "search",
            "arrow-right",
            "chevron-down",
            "settings",
            "bell",
            "volume",
            "sparkle"
          ],
          "default": "none"
        },
        {
          "prop": "type",
          "control": "select",
          "label": "Type",
          "options": [
            "text",
            "email",
            "password",
            "search"
          ],
          "default": "text"
        },
        {
          "prop": "clearable",
          "control": "switch",
          "label": "Clear button",
          "default": false
        },
        {
          "prop": "disabled",
          "control": "switch",
          "label": "Disabled",
          "default": false
        }
      ]
    }
  ],
  "values": {
    "label": "Email",
    "placeholder": "you@example.com",
    "hint": "We never share your address."
  }
}
