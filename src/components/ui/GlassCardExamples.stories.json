{
  "$schema": "https://forge.ui8.ai/schemas/stories.v3.json",
  "name": "Glass Card Examples",
  "component": "./GlassCard.tsx#GlassCardExamples",
  "canvas": {
    "layout": "padded"
  },
  "sections": [
    {
      "title": null,
      "controls": [
        {
          "prop": "theme",
          "control": "segmented",
          "label": "Theme",
          "options": [
            "light",
            "dark"
          ],
          "default": "light"
        }
      ]
    },
    {
      "title": "Glass",
      "tab": "Glass",
      "collapsible": true,
      "controls": [
        {
          "prop": "frostedOverlay",
          "control": "slider",
          "label": "Frosted overlay",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "default": 1
        },
        {
          "prop": "frostedRadius",
          "control": "slider",
          "label": "Frosted radius",
          "min": 0,
          "max": 40,
          "step": 0.5,
          "default": 10
        },
        {
          "prop": "borderWidth",
          "control": "slider",
          "label": "Border width",
          "min": 0,
          "max": 5,
          "step": 0.1,
          "default": 1.3
        },
        {
          "prop": "refractStrength",
          "control": "slider",
          "label": "Refract strength",
          "min": 0,
          "max": 0.15,
          "step": 0.005,
          "default": 0.065
        }
      ]
    }
  ],
  "values": {}
}
