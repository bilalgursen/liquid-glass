{
  "$schema": "https://forge.ui8.ai/schemas/stories.v3.json",
  "name": "Button",
  "component": "./Button.tsx#Button",
  "canvas": {
    "layout": "centered"
  },
  "sections": [
    {
      "title": null,
      "controls": [
        {
          "prop": "theme",
          "control": "segmented",
          "label": "Theme",
          "options": [
            "light",
            "dark"
          ],
          "default": "light"
        },
        {
          "prop": "variant",
          "control": "segmented",
          "label": "Variant",
          "options": [
            "glass",
            "frosted",
            "ghost"
          ],
          "default": "glass"
        },
        {
          "prop": "size",
          "control": "segmented",
          "label": "Size",
          "options": [
            "sm",
            "md",
            "lg"
          ],
          "default": "md"
        },
        {
          "prop": "iconOnly",
          "control": "switch",
          "label": "Icon only",
          "default": false
        }
      ]
    },
    {
      "title": "Icons",
      "collapsible": true,
      "controls": [
        {
          "prop": "icon",
          "control": "select",
          "label": "Leading icon",
          "options": [
            "none",
            "sun",
            "moon",
            "plus",
            "minus",
            "check",
            "close",
            "search",
            "arrow-right",
            "chevron-down",
            "settings",
            "bell",
            "volume",
            "sparkle"
          ],
          "default": "none"
        },
        {
          "prop": "trailingIcon",
          "control": "select",
          "label": "Trailing icon",
          "options": [
            "none",
            "sun",
            "moon",
            "plus",
            "minus",
            "check",
            "close",
            "search",
            "arrow-right",
            "chevron-down",
            "settings",
            "bell",
            "volume",
            "sparkle"
          ],
          "default": "none",
          "visibleWhen": {
            "prop": "iconOnly",
            "equals": false
          }
        }
      ]
    },
    {
      "title": "Glass",
      "collapsible": true,
      "controls": [
        {
          "prop": "swell",
          "control": "slider",
          "label": "Press swell",
          "min": 1,
          "max": 1.3,
          "step": 0.01,
          "default": 1.08
        },
        {
          "prop": "hoverScale",
          "control": "slider",
          "label": "Hover label scale",
          "min": 1,
          "max": 1.15,
          "step": 0.01,
          "default": 1.04
        },
        {
          "prop": "labelTransition",
          "control": "spring",
          "label": "Label spring",
          "default": {
            "type": "spring",
            "stiffness": 256,
            "damping": 19.2,
            "mass": 1
          }
        },
        {
          "prop": "disabled",
          "control": "switch",
          "label": "Disabled",
          "default": false
        }
      ]
    }
  ],
  "values": {
    "children": "Continue"
  }
}
